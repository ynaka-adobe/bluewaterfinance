{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "home",
      "urls": [
        "https://bluewaterfinance.com/"
      ],
      "representativeUrl": "https://bluewaterfinance.com/",
      "description": "Homepage: hero slideshow, CTA tiles, service cards, intro copy and partner logos",
      "urlPattern": "/",
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            ".feature-banner .cycle-slideshow"
          ]
        },
        {
          "name": "columns-cta",
          "instances": [
            "#outterWrapper > .row.contentContainer:nth-of-type(3) .mainContent > .row"
          ]
        },
        {
          "name": "cards-services",
          "instances": [
            ".bannerContainer"
          ]
        },
        {
          "name": "columns-logos",
          "instances": [
            ".theLogos"
          ]
        }
      ],
      "sections": [
        {
          "id": "1",
          "name": "hero-slideshow",
          "selector": [
            ".feature-banner.cycle2absolute",
            ".cycle2main"
          ],
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "2",
          "name": "cta-tiles",
          "selector": [
            "#outterWrapper > .row.contentContainer:nth-of-type(3)"
          ],
          "style": null,
          "blocks": [
            "columns-cta"
          ],
          "defaultContent": []
        },
        {
          "id": "3",
          "name": "services",
          "selector": [
            ".windowOuter:has(.bannerContainer)",
            "#outterWrapper > .windowOuter:nth-of-type(4)"
          ],
          "style": null,
          "blocks": [
            "cards-services"
          ],
          "defaultContent": [
            ".windowOuter:has(.bannerContainer) .mainheading h2"
          ]
        },
        {
          "id": "4",
          "name": "intro",
          "selector": [
            "#outterWrapper > .row.contentContainer:has(.wysiwyg)",
            "#outterWrapper > .row.contentContainer:nth-of-type(5)"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            ".mainheading h1",
            ".wysiwyg p",
            "img[alt='all different boats']"
          ]
        },
        {
          "id": "5",
          "name": "partners",
          "selector": [
            ".windowOuter:has(.theLogos)",
            "#outterWrapper > .windowOuter:nth-of-type(6)"
          ],
          "style": null,
          "blocks": [
            "columns-logos"
          ],
          "defaultContent": [
            ".financialPartnerHeading h2"
          ]
        }
      ]
    },
    {
      "name": "content-page",
      "urls": [
        "https://bluewaterfinance.com/loans/",
        "https://bluewaterfinance.com/protection/",
        "https://bluewaterfinance.com/insurance/",
        "https://bluewaterfinance.com/prequalify/",
        "https://bluewaterfinance.com/apply/",
        "https://bluewaterfinance.com/dealer-tools/"
      ],
      "representativeUrl": "https://bluewaterfinance.com/protection/",
      "description": "Inner content page: hero banner with caption, breadcrumb, main copy + sidebar (sub-nav, CTA tiles), boat line-up image, partner logos",
      "urlPattern": "/*/",
      "blocks": [
        {
          "name": "hero-caption",
          "instances": [
            "#pnlSubPageImage"
          ]
        },
        {
          "name": "accordion-boxed",
          "instances": [
            "#pnlContent > .wysiwyg:has(.accordionPP)"
          ]
        },
        {
          "name": "columns-cta",
          "instances": [
            ".mainContent > .row > .medium-3.columns center"
          ]
        },
        {
          "name": "columns-logos",
          "instances": [
            ".theLogos"
          ]
        }
      ],
      "sections": [
        {
          "id": "1",
          "name": "hero",
          "selector": [
            "#pnlSubPageImage"
          ],
          "style": null,
          "blocks": [
            "hero-caption"
          ],
          "defaultContent": []
        },
        {
          "id": "2",
          "name": "main-content",
          "selector": [
            ".mainContent > .row > .pageContent"
          ],
          "style": "main-content",
          "blocks": [
            "accordion-boxed"
          ],
          "defaultContent": [
            "#pnlContent > .wysiwyg p",
            "#pnlContent > .wysiwyg h2",
            "#pnlContent > .wysiwyg ul"
          ]
        },
        {
          "id": "3",
          "name": "sidebar",
          "selector": [
            ".mainContent > .row > .medium-3.columns"
          ],
          "style": "sidebar",
          "blocks": [
            "columns-cta"
          ],
          "defaultContent": [
            "#nav-wrap ul.sublist"
          ]
        },
        {
          "id": "4",
          "name": "boat-lineup",
          "selector": [
            ".mainContent > div:has(img[alt=\"all different boats\"])",
            ".mainContent > div:nth-child(2)"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "img[alt=\"all different boats\"]"
          ]
        },
        {
          "id": "5",
          "name": "partners",
          "selector": [
            ".windowOuter:has(.theLogos)"
          ],
          "style": null,
          "blocks": [
            "columns-logos"
          ],
          "defaultContent": [
            ".financialPartnerHeading h2"
          ]
        }
      ]
    }
  ]
}
